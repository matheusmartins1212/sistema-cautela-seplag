# =============================================================================
# Sistema de Cautela de Veículos — SEPLAG-MT
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA versione o arquivo `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development
# URL base pública da aplicação (usada em links de e-mail). Sem barra final.
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Em nuvem (Neon/Supabase): cole a connection string com sslmode=require.
# Ex.: postgresql://user:senha@host/dbname?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cautela_veiculos?schema=public"

# -----------------------------------------------------------------------------
# Sessão / Autenticação
# Gere segredos fortes e aleatórios (32+ bytes). Ex.: `openssl rand -base64 48`
# -----------------------------------------------------------------------------
SESSION_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes-ou-mais"
# Tempo de vida da sessão (em segundos). Padrão: 8 horas.
SESSION_TTL_SECONDS=28800

# Segredo independente para assinatura/derivação de tokens de e-mail.
EMAIL_TOKEN_SECRET="troque-por-outro-segredo-aleatorio-distinto"
EMAIL_CONFIRMATION_TOKEN_EXPIRES_IN=24h
PASSWORD_RESET_TOKEN_EXPIRES_IN=30m

# -----------------------------------------------------------------------------
# Regra de domínio institucional
# Apenas e-mails neste domínio podem concluir cadastro automaticamente.
# -----------------------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=seplag.mt.gov.br

# -----------------------------------------------------------------------------
# Super administrador inicial (criado pelo seed). Não hardcodar no código.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@seplag.mt.gov.br"
SUPER_ADMIN_PASSWORD="DefinaUmaSenhaForte#2026"
SUPER_ADMIN_NAME="Administrador do Sistema"
SUPER_ADMIN_CPF="00000000000"
SUPER_ADMIN_REGISTRATION="000000"

# -----------------------------------------------------------------------------
# E-mail transacional (abstração por provider — ver módulo de e-mail)
# EMAIL_PROVIDER: smtp | console (console = apenas loga em dev, não envia)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM_NAME="Sistema de Cautela de Veículos - SEPLAG-MT"
EMAIL_FROM_ADDRESS="nao-responda@seplag.mt.gov.br"

# SMTP (quando EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Provedor transacional via API (opcional / futuro)
EMAIL_API_KEY=
EMAIL_API_BASE_URL=

# -----------------------------------------------------------------------------
# Storage de arquivos (fotos dos checklists)
# STORAGE_DRIVER: local | supabase | s3
#   local    = pasta ./storage, apenas para dev (NÃO funciona na Vercel)
#   supabase = Supabase Storage (bucket privado) — use em produção na Vercel
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
# Quando STORAGE_DRIVER=supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=checklist-photos
# Quando STORAGE_DRIVER=s3 (S3 / MinIO / R2):
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Tamanho máximo por foto (bytes). Padrão: 8 MB.
UPLOAD_MAX_BYTES=8388608

# -----------------------------------------------------------------------------
# Rate limiting (login/cadastro/reset). Janela em segundos e tentativas máximas.
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Jobs agendados (POST /api/cron)
# Segredo (32+ chars) exigido no cabeçalho Authorization: Bearer <segredo>.
# Se vazio, a rota /api/cron fica DESABILITADA (responde 404).
# Acione por um agendador externo, ex. (a cada 15 min):
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://SEU_HOST/api/cron
# Jobs: marca cautelas atrasadas + limpa sessões/tokens expirados.
# -----------------------------------------------------------------------------
CRON_SECRET=
